<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal Spring Boot application for headless-export verification.

     Depends on spring-boot-starter-web so that:
     - spring-context JAR is on the classpath → stereotype annotations
       (@Service, @Component, @Repository, @Controller, @Configuration) and
       @Autowired/@Qualifier resolve via JavaPsiFacade.findClass.
     - spring-web JAR is on the classpath → @RestController, @RequestMapping,
       @GetMapping etc. resolve, so SpringCollector emits ENDPOINT beans and
       AutoConfigCollector can read spring.factories from the starter JARs.

     This is the depth tier the headless feature exists for: the Spring/JPA
     model that Community PSI alone can't see. Requires IntelliJ Ultimate
     (platformType=IU) — the starter JARs are Maven-resolved, but the bundled
     Spring plugin model (SpringModelCollector) needs Ultimate. The pure-PSI
     SpringCollector below works on either, given the JARs. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>
  <groupId>com.onelens</groupId>
  <artifactId>spring-fixture</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
    <java.version>17</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>
</project>
